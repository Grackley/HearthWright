{
  "name": "hearthwright",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "A desktop build planner for Valheim, calibrated to full-world PNG maps.",
  "author": "Grack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grackley/HearthWright.git"
  },
  "homepage": "https://github.com/Grackley/HearthWright#readme",
  "bugs": {
    "url": "https://github.com/Grackley/HearthWright/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src electron tests tools/*.cjs vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "catalog:generate": "node tools/generate-buildable-supplement.cjs",
    "visuals:bundle": "node tools/build-visual-bundle.cjs",
    "desktop": "pnpm build && electron .",
    "package:portable": "pnpm build && electron-builder --win portable",
    "package:win": "pnpm build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.grack1985.hearthwright",
    "productName": "Hearthwright",
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "visual-assets/bundles/current",
        "to": "Visuals",
        "filter": [
          "manifest.json",
          "sprites/**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "resources/hearthwright-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Hearthwright-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Hearthwright-Portable-${version}.${ext}"
    }
  }
}
